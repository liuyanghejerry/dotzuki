      "label": "Data",
      "icon": "database",
      "enabled": true,
      "config": {
        "tables": [
          {
            "id": "characters",
            "label": "Characters",
            "dir": "characters",
            "icon": "user",
            "idField": "id",
            "fields": [
              { "key": "id", "type": "string", "label": "ID", "required": true },
              { "key": "name", "type": "string", "label": "Name", "required": true },
              { "key": "element", "type": "select", "label": "Element",
