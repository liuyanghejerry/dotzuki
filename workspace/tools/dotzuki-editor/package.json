{
  "name": "dotzuki-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Game-agnostic editor for dotzuki-engine — configure via .dotzuki-editor.json in your project",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "demo": "DOTZUKI_PROJECT_ROOT=$(pwd)/test-project vite",
    "build:wasm": "cd ../../crates/dotzuki-web && wasm-pack build --target web --out-dir pkg --dev -- --features modern-audio && wasm-pack build --target nodejs --out-dir pkg-node --dev -- --features modern-audio",
    "build:wasm-runner": "cd ../../crates/dotzuki-runner-web && wasm-pack build --target web --out-dir pkg --dev -- --features modern-audio",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "electron:dev": "node electron/dev.mjs",
    "electron:demo": "DOTZUKI_PROJECT_ROOT=$(pwd)/test-project node electron/dev.mjs",
    "build:renderer": "vite build",
    "build:server": "node electron/build-server.mjs",
    "build:resources": "node electron/stage-resources.mjs",
    "electron:build": "pnpm run build:renderer && pnpm run build:server && pnpm run build:resources",
    "electron:preview": "pnpm run electron:build && cross-env ELECTRON_PROD=1 electron electron/main.cjs",
    "electron:pack": "pnpm run electron:build && electron-builder --dir --config electron-builder.cjs",
    "electron:dist": "pnpm run electron:build && electron-builder --config electron-builder.cjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/vue": "^4.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.1.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "ai": "^6.0.198",
    "codemirror": "^6.0.2",
    "connect": "^3.7.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "pngjs": "^7.0.0",
    "sirv": "^3.0.1",
    "undici": "^7.29.0",
    "vue": "^3.5.30",
    "vue-i18n": "^10.0.7",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/connect": "^3.4.38",
    "@types/json-schema": "^7.0.15",
    "@types/pngjs": "^6.0.5",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "vitest": "^4.1.9"
  }
}
