# dsh-runtime is a STANDALONE optional package, deliberately NOT part of the
# workspace/tools pnpm workspace (its deps are heavy and only needed when the
# DeepSeek Harness assistant backend is enabled). Keep pnpm from walking up to
# the workspace root so `pnpm install` here resolves this package on its own.
ignore-workspace=true

# The npmmirror registry does not carry all @deepseek-ai packages yet — use
# the official npm registry for this standalone install.
registry=https://registry.npmjs.org/
