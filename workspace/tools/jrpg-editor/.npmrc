# Electron binaries are large (~100MB+). If the default download is slow or
# fails, these China mirrors (npmmirror / 淘宝镜像) usually fix it. They only
# affect where the Electron + electron-builder *binaries* come from, not which
# npm packages you install.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# If npm itself (the package tarballs) is slow, uncomment to use the npmmirror
# registry too. Leave commented to keep using the default npm registry.
# registry=https://registry.npmmirror.com
