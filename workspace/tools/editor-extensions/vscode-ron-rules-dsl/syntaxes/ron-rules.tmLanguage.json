{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RON Rules DSL",
  "scopeName": "source.ron-rules",
  "patterns": [
    {
      "match": "//.*$",
      "name": "comment.line.double-slash.ron-rules"
    },
    {
      "match": "\"([^\"\\\\]|\\\\.)*\"",
      "name": "string.quoted.double.ron-rules"
    },
    {
      "match": "\\b(id|kind|category|power|type|accuracy|cost|hooks|on|order|chance|do|stats|resources|types|type_chart|effects|status|target|source|of|stages|num|den|cond|when|unless|value|count|final_hit|ops|resource|amount|atk|def|mult)\\b",
      "name": "support.constant.ron-rules"
    },
    {
      "match": "-?\\b\\d+\\b",
      "name": "constant.numeric.ron-rules"
    },
    {
      "match": "\\b(Ruleset|Effect|Hook|Cost|OnFinal)\\s*\\(",
      "captures": {
        "1": {
          "name": "support.type.ron-rules"
        }
      }
    },
    {
      "match": "\\b(Move|Status|Ability|Item|Weather|Physical|Special)\\b",
      "name": "keyword.other.ron-rules"
    },
    {
      "match": "\\b(DealMoveDamage|ApplyTypeChart|InflictStatus|DamageFraction|HealFraction|Boost|VetoIf|ScaleRelay|SetDamage|DamageCurrentHpFraction|SetHp|RepeatHits|RemoveStatus)\\b",
      "name": "support.function.ron-rules"
    },
    {
      "match": "\\b(HasType|HasVolatile|StatIs|RelayIntLt|TargetHasStatus|SourceHasStatus|MoveTypeIsDefenderType|LevelGE|SelfHpBelow)\\b",
      "name": "entity.name.function.ron-rules"
    },
    {
      "match": "\\b(ModifyDamage|Effectiveness|DamagingHit|Residual|FieldResidual|SwitchIn|TryBoost|BeforeMove|AfterMove|Heal|ModifyCritRatio|ModifyStat|Accuracy|WeatherModifyStat|Custom)\\b",
      "name": "entity.name.tag.ron-rules"
    },
    {
      "match": "\\b(TwoToFive|Fixed)\\b",
      "name": "support.type.ron-rules"
    },
    {
      "match": "\\b(Target|Source|Foe|Host|MaxHp|LastDamage|UserLevel|Const|RngScaledLevel)\\b",
      "name": "variable.other.ron-rules"
    },
    {
      "match": "[:,]",
      "name": "keyword.operator.ron-rules"
    },
    {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.ron-rules"
    }
  ],
  "repository": {}
}
