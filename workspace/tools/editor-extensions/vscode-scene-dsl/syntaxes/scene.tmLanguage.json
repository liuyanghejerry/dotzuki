{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Scene DSL",
  "scopeName": "source.scene",
  "fileTypes": ["scene"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#scene_definition" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.scene"
    },
    "scene_definition": {
      "begin": "\\b(game_scene)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.control.scene" },
        "2": { "name": "entity.name.type.scene" }
      },
      "patterns": [
        { "include": "#body" }
      ]
    },
    "body": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#decorator_with_body" },
        { "include": "#decorator_no_body" },
        { "include": "#assignment" },
        { "include": "#function_call" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#operators" }
      ]
    },
    "decorator_with_body": {
      "begin": "@([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?:\\([^)]*\\))?\\s*\\{",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.decorator.scene" }
      },
      "patterns": [
        { "include": "#body" }
      ]
    },
    "decorator_no_body": {
      "match": "@([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\([^)]*\\)",
      "captures": {
        "1": { "name": "keyword.other.decorator.scene" }
      }
    },
    "assignment": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)(?!=)\\s*",
      "captures": {
        "1": { "name": "variable.other.scene" },
        "2": { "name": "keyword.operator.scene" }
      }
    },
    "function_call": {
      "begin": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "support.function.scene" }
      },
      "patterns": [
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#operators" }
      ]
    },
    "strings": {
      "match": "\"[^\"]*\"",
      "name": "string.quoted.double.scene"
    },
    "numbers": {
      "match": "\\b\\d+\\b",
      "name": "constant.numeric.scene"
    },
    "booleans": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.scene"
    },
    "operators": {
      "match": "==",
      "name": "keyword.operator.scene"
    }
  }
}
