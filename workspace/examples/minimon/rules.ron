// rules.ron — minimon's battle ruleset, authored as DATA against the closed
// no-code vocabulary (doc 11 §1.1, doc 12 §2). This is the SINGLE source of
// truth that the dual-mode `dotzuki_rules::RuleSource` loads either BAKED
// (include_str!, release) or from DISK (dev, hot-reloaded). The minimon parity
// test (`tests::data_parity`) drives the SAME battle scenarios through (a) the
// native-Rust minimon effects (the oracle, lib.rs) and (b) these data-loaded
// effects, asserting IDENTICAL `BattleState` and identical `ScriptedRng` draws.
//
// Every name below binds to the CLOSED engine vocabulary at LOAD — an unknown
// event/op/type/stat/status is a load error, never a battle-time surprise.
//
// What is re-homed to DATA here (vs left native — see lib.rs `// NATIVE:`):
//   • the 金木水火土 type chart + per-element typed moves  (ApplyTypeChart)
//   • the poison residual chip (1/8, order 10)            (DamageFraction)
//   • Leftovers (1/16 heal, order 20, AFTER the chip)     (HealFraction)
//   • Sandstorm chip (1/16 non-Rock) + Rock SpD ×1.5      (DamageFraction / ScaleRelay)
//   • Intimidate (-1 Atk request) + Clear Body (veto)     (Boost / VetoIf)
// The nested TryBoost veto CASCADE between Intimidate and Clear Body stays
// driver orchestration (doc 11 §3) — IDENTICAL for the native and data paths.
Ruleset(
    // The 6-stat Gen-4 shape (lib.rs `Stat`); order = the interned stat index the
    // binding maps ↔ minimon's `Stat`.
    stats: ["Hp", "Atk", "Def", "SpA", "SpD", "Spe"],

    // The generic resource pool (doc 13 §4): a single resource, MP, spent by the
    // special (元素/elemental) moves. Order = the interned resource index the
    // binding maps ↔ the engine's opaque resource id (lib.rs `Resource::Mp.id()`).
    resources: ["MP"],

    // The element names (lib.rs `MType`). Order here is the ruleset's own intern
    // order; the binding maps each name ↔ `MType` (whose `chart_index()` is the
    // engine-facing opaque index). Normal/Rock are the Sandstorm pair and carry
    // no chart edge (always neutral). The 金木水火土 five drive the chart proof.
    types: ["Normal", "Rock", "Metal", "Wood", "Water", "Fire", "Earth"],

    // doc 12 §2: the 金木水火土 相克 wheel as integer rationals. Omitted pairs = 1×.
    // These reproduce lib.rs `TYPE_CHART` exactly (the binding looks up the same
    // edges via minimon's native `type_chart_mult`).
    type_chart: [
        // ── super-effective (2×) — the 克 edges ──────────────────────────────
        ( atk: "Metal", def: "Wood",  mult: [2, 1] ),   // 金克木
        ( atk: "Wood",  def: "Earth", mult: [2, 1] ),   // 木克土
        ( atk: "Earth", def: "Water", mult: [2, 1] ),   // 土克水
        ( atk: "Water", def: "Fire",  mult: [2, 1] ),   // 水克火
        ( atk: "Fire",  def: "Metal", mult: [2, 1] ),   // 火克金
        // ── resisted (1/2×) — the reverse edges ──────────────────────────────
        ( atk: "Wood",  def: "Metal", mult: [1, 2] ),
        ( atk: "Earth", def: "Wood",  mult: [1, 2] ),
        ( atk: "Water", def: "Earth", mult: [1, 2] ),
        ( atk: "Fire",  def: "Water", mult: [1, 2] ),
        ( atk: "Metal", def: "Fire",  mult: [1, 2] ),
        // ── immunity (0×) — the one demonstrative no-effect pair ──────────────
        ( atk: "Water", def: "Wood",  mult: [0, 1] ),   // 水→木 immunity
    ],

    effects: [
        // ── damaging moves: ModifyDamage marker (provider precomputes the split-
        //    aware damage) + the shared Effectiveness chart fold. The phys/special
        //    SPLIT itself is provider+data (category/power), invisible to the
        //    engine — exactly as the native oracle's calculate_damage reads it.

        // Normal-typed demo moves (no chart edge ⇒ chart fold is identity 1×).
        Effect(id: "move.tackle", kind: Move, category: "Physical", power: 40, type: "Normal", accuracy: 100,
            hooks: [
                Hook(on: "ModifyDamage",  do: [ DealMoveDamage ]),
                Hook(on: "Effectiveness", order: 100, do: [ ApplyTypeChart ]),
            ]),
        Effect(id: "move.ember", kind: Move, category: "Special", power: 40, type: "Normal", accuracy: 100,
            hooks: [
                Hook(on: "ModifyDamage",  do: [ DealMoveDamage ]),
                Hook(on: "Effectiveness", order: 100, do: [ ApplyTypeChart ]),
            ]),

        // 金 Metal move (power 80) — drives 金克木 super-effective + Metal resisted.
        // 元素 special move ⇒ costs 3 MP (doc 13 §4, the cost-gate proof).
        Effect(id: "move.blade", kind: Move, category: "Physical", power: 80, type: "Metal", accuracy: 100,
            cost: [ Cost(resource: "MP", amount: 3) ],
            hooks: [
                Hook(on: "ModifyDamage",  do: [ DealMoveDamage ]),
                Hook(on: "Effectiveness", order: 100, do: [ ApplyTypeChart ]),
            ]),
        // 水 Water move (power 80) — drives the 水→木 immunity case. 元素 special
        // move ⇒ costs 5 MP.
        Effect(id: "move.torrent", kind: Move, category: "Special", power: 80, type: "Water", accuracy: 100,
            cost: [ Cost(resource: "MP", amount: 5) ],
            hooks: [
                Hook(on: "ModifyDamage",  do: [ DealMoveDamage ]),
                Hook(on: "Effectiveness", order: 100, do: [ ApplyTypeChart ]),
            ]),

        // ── poison residual chip — order 10 = BEFORE Leftovers (the doc 11 §6
        //    single must-pass cross-source ordering: chip then heal).
        Effect(id: "status.poison", kind: Status,
            hooks: [ Hook(on: "Residual", order: 10, do: [
                DamageFraction(num: 1, den: 8, of: MaxHp, target: Host) ]) ]),

        // ── Leftovers — heal 1/16 each end-of-turn, AFTER the status chip.
        Effect(id: "item.leftovers", kind: Item,
            hooks: [ Hook(on: "Residual", order: 20, do: [
                HealFraction(num: 1, den: 16, of: MaxHp, target: Host) ]) ]),

        // ── Sandstorm — chip non-Rock 1/16; ×1.5 SpD for Rock. Field-hosted.
        Effect(id: "weather.sandstorm", kind: Weather,
            hooks: [
                Hook(on: "FieldResidual", order: 50, do: [
                    DamageFraction(num: 1, den: 16, of: MaxHp, target: Target, unless: HasType("Rock")) ]),
                Hook(on: "WeatherModifyStat", order: 50, do: [
                    ScaleRelay(num: 3, den: 2, when: [ HasType("Rock"), StatIs("SpD") ]) ]),
            ]),

        // ── Intimidate — on switch-in, request -1 foe Atk. The driver routes this
        //    through a nested TryBoost where Clear Body can veto (doc 11 §3).
        Effect(id: "ability.intimidate", kind: Ability,
            hooks: [ Hook(on: "SwitchIn", order: 10, do: [
                Boost(stat: "Atk", stages: -1, target: Foe) ]) ]),

        // ── Clear Body — veto any negative boost on the holder (the TryBoost veto
        //    that gates Intimidate's request).
        Effect(id: "ability.clearbody", kind: Ability,
            hooks: [ Hook(on: "TryBoost", order: 5, do: [
                VetoIf(cond: RelayIntLt(0)) ]) ]),
    ],
)
